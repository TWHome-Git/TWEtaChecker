<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- TWChatOverlay와 같은 다크(#111) + 민트(#0CD29D) 색 체계. 팝업 하나뿐이라 필요한 브러시만 둔다. -->
    <SolidColorBrush x:Key="TextBrush" Color="#E8EAE9"/>
    <SolidColorBrush x:Key="OverlayWindowBackgroundBrush" Color="#F0121816"/>
    <SolidColorBrush x:Key="OverlayWindowBorderBrush" Color="#FF2A332E"/>
    <SolidColorBrush x:Key="OverlayCardBackgroundBrush" Color="#FF161D1A"/>
    <SolidColorBrush x:Key="OverlayCardBorderBrush" Color="#FF232B27"/>
    <SolidColorBrush x:Key="OverlayTitleAccentTextBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="OverlayMutedTextBrush" Color="#FF8C9197"/>
    <SolidColorBrush x:Key="OverlayHintTextBrush" Color="#FF77807B"/>
    <SolidColorBrush x:Key="OverlayTabHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="OverlayTabSelectedBrush" Color="#1F0CD29D"/>
    <SolidColorBrush x:Key="OverlayTabSelectedBorderBrush" Color="#FF0CD29D"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF2E3833"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFE8EAE9"/>

    <!-- 메인·설정 창 버튼. 기본은 옅은 회색 테두리, Primary는 민트 강조. -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource OverlayTabHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#400CD29D"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OverlayTitleAccentTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- 카드 안의 "이름 : 값" 줄 -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource OverlayMutedTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>
    <Style x:Key="FieldValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource OverlayTitleAccentTextBrush}"/>
        <Setter Property="Margin" Value="2,0,0,6"/>
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OverlayCardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Background="{DynamicResource OverlayTabHoverBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,0">
                        <TextBlock Text="닫기"
                                   FontSize="11"
                                   Foreground="{DynamicResource ButtonTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource OverlayTabSelectedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource OverlayTabSelectedBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
