<Window x:Class="TWEtaChecker.Views.EtaToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        MinHeight="90"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Malgun Gothic">
    <!-- 가는 창 테두리, 민트 제목, 카드에 담은 목록, 힌트 각주. 상대마다 한 줄 — 아이디와 에타 레벨 알약. -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource OverlayWindowBackgroundBrush}"
            BorderBrush="{DynamicResource OverlayWindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14,10,14,10"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Grid.Row="0" Margin="0,0,0,8" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource OverlayTabSelectedBrush}"
                            BorderBrush="{DynamicResource OverlayTabSelectedBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="7,0,7,1"
                            Height="18"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                        <TextBlock Text="1:1 대화" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OverlayTitleAccentTextBrush}" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText"
                               Text="에타 레벨 확인"
                               Foreground="{DynamicResource OverlayTitleAccentTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource WindowCloseButtonStyle}"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource OverlayCardBackgroundBrush}"
                    BorderBrush="{DynamicResource OverlayCardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6,4">
                <StackPanel x:Name="EntryList"/>
            </Border>

            <TextBlock x:Name="FootnoteText"
                       Grid.Row="2"
                       Margin="4,7,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource OverlayHintTextBrush}">
                <Run Text="ⓘ" Foreground="{DynamicResource OverlayTitleAccentTextBrush}"/>
                <Run Text=" 에타 랭킹 데이터 기준"/>
            </TextBlock>
        </Grid>
    </Border>
</Window>
